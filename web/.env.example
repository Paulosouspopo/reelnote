# Copie en .env.local pour le dev, et ajoute les mêmes variables dans Vercel.
# Toutes sont publiques par nature (préfixe NEXT_PUBLIC_) : aucune clé secrète ici.

# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Clé publique VAPID (npx web-push generate-vapid-keys) — la privée va dans le worker
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
