# ---------------------------------------------------------------------------
# Worker Reelnote — copie ce fichier en .env et remplis les valeurs.
# Ne commite JAMAIS le fichier .env (il est dans .gitignore).
# ---------------------------------------------------------------------------

# Supabase > Connect > "Session pooler" (port 5432, compatible IPv4 et LISTEN/NOTIFY)
DATABASE_URL=postgresql://postgres.xxxxxxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Supabase > Project Settings > API Keys
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Modèle d'analyse : Haiku suffit pour la grande majorité des reels
ANALYSIS_MODEL=claude-haiku-4-5

# Notifications push (même paire de clés que la web app, voir docs/SETUP.md)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:toi@exemple.com

# Whisper : tiny | base | small | medium. "small" = bon compromis qualité/vitesse sur CPU
WHISPER_MODEL=small

# Optionnel : cookies Instagram si des reels échouent avec "auth_required"
# YTDLP_COOKIES_FILE=/run/secrets/cookies.txt

# Logs lisibles en local (true = JSON, pour la prod)
LOG_JSON=false
LOG_LEVEL=INFO
